# Ganti dengan key acak, misal: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=ganti-dengan-key-rahasia

# --- Docker (docker compose) ---
# Port di mesin host yang diteruju reverse proxy (ganti kalau bentrok dengan app lain)
APP_PORT=8000
# 127.0.0.1 = hanya bisa diakses dari mesin ini (lewat reverse proxy). 0.0.0.0 = terbuka ke jaringan.
APP_BIND=127.0.0.1

# --- Lokal (tanpa Docker) ---
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# false = browser kelihatan (enak buat debugging selector)
HEADLESS=true

# Proxy untuk semua trafik keluar ke ElevenLabs. Kosong = langsung dari IP server.
# Cloudflare WARP (mode proxy):  socks5://127.0.0.1:40000
# Cek hasilnya lewat GET /egress
PROXY_URL=
MAX_CONCURRENCY=2
NAV_TIMEOUT_MS=30000
GENERATE_TIMEOUT_MS=180000

# Webhook saat job selesai/gagal (kosongkan kalau tidak dipakai; bisa juga per request lewat webhook_url)
WEBHOOK_URL=
# Kalau diisi, request webhook diberi header X-Elevenag-Signature (HMAC-SHA256)
WEBHOOK_SECRET=
# Alamat API ini dari sisi penerima webhook (untuk download_url di payload)
PUBLIC_BASE_URL=http://localhost:8000

# Default generate (dipakai kalau tidak dikirim di POST /tts)
DEFAULT_MODEL_ID=eleven_v4_exp
DEFAULT_VOICE_ID=zmqLb9Ysr8fUvDD7hXK8
DEFAULT_VOICE_NAME=Zan - Conversational
DEFAULT_STABILITY=0.5
DEFAULT_SIMILARITY=0.75

